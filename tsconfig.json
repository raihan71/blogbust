{
  "compilerOptions": {
    "jsx": "preserve",

    "module": "NodeNext",
    "moduleResolution": "nodenext",

    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
  },
  "exclude": ["dist/"]
}
